<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- ============================================================
         콘서트 예매 시스템 로깅 설정
         - 로컬(default): 읽기 쉬운 텍스트 포맷
         - 운영(prod): JSON 구조화 로깅 (ELK/Loki 연동 대비)
         ============================================================ -->

    <!-- 공통 속성 -->
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="ticketing"/>

    <!-- ── 로컬 개발: 콘솔 텍스트 ── -->
    <springProfile name="default,local,test">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- ── 운영: JSON 구조화 로깅 (Logstash Encoder) ── -->
    <springProfile name="prod">
        <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"app":"${appName}"}</customFields>
                <timeZone>Asia/Seoul</timeZone>
            </encoder>
        </appender>

        <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>logs/ticketing.json.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>logs/ticketing.%d{yyyy-MM-dd}.%i.json.log</fileNamePattern>
                <maxFileSize>50MB</maxFileSize>
                <maxHistory>30</maxHistory>
                <totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"app":"${appName}"}</customFields>
                <timeZone>Asia/Seoul</timeZone>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
            <appender-ref ref="JSON_FILE"/>
        </root>
    </springProfile>
</configuration>
